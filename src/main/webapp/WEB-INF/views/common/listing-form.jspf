<%-- Shared Sell / Edit form (static include). Model: form (ListingForm), errors (map), formError,
     categories, conditions; listing is present only when editing. --%>
<c:set var="editing" value="${not empty listing}" />
<form class="card card-pad-lg form" method="post" action="${ctx}/${editing ? 'edit' : 'sell'}" enctype="multipart/form-data" data-validate>
    <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
    <c:if test="${editing}"><input type="hidden" name="id" value="${listing.id}"></c:if>

    <c:if test="${not empty formError}">
        <div class="alert alert-error" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="7.5" x2="12" y2="13"/><circle cx="12" cy="16.5" r=".6" fill="currentColor"/></svg>
            <p><c:out value="${formError}" /></p>
        </div>
    </c:if>

    <div class="field${not empty errors.image ? ' has-error' : ''}">
        <span class="label">Photo <c:choose><c:when test="${editing}"><span class="optional">(optional &middot; leave empty to keep the current photo)</span></c:when><c:otherwise><span class="optional">(required)</span></c:otherwise></c:choose></span>
        <label class="file-drop${editing ? ' has-file' : ''}"${editing ? ' data-has-existing' : ''}>
            <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp"
                   data-max-bytes="${maxUploadMb * 1024 * 1024}"${editing ? '' : ' required'}
                   data-msg-required="A photo is required. Please add a clear picture of your item.">
            <c:choose>
                <c:when test="${editing}"><img class="file-preview" src="${ctx}/${fn:escapeXml(listing.imageUrl)}" alt="Current photo"></c:when>
                <c:otherwise><img class="file-preview" alt="Selected photo preview"></c:otherwise>
            </c:choose>
            <span class="file-prompt">
                <svg class="file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 9"/></svg>
                <strong>Click to upload a photo</strong> or drag it here<br>
                <span class="hint">JPG, PNG or WebP &middot; up to <c:out value="${maxUploadMb}" /> MB &middot; at least 300 &times; 300 px</span>
            </span>
        </label>
        <p class="file-name" aria-live="polite"><c:if test="${editing}">Current photo shown. Choose a new file to replace it.</c:if></p>
        <c:if test="${not empty errors.image}"><p class="field-error"><c:out value="${errors.image}" /></p></c:if>
    </div>

    <div class="field${not empty errors.title ? ' has-error' : ''}">
        <label class="label" for="title">Title</label>
        <input class="input" id="title" name="title" value="${fn:escapeXml(form.title)}" required minlength="5" maxlength="100"
               data-counter placeholder="e.g. Casio fx-991ES Plus Scientific Calculator" data-msg-required="Please give your item a title.">
        <p class="counter"></p>
        <c:if test="${not empty errors.title}"><p class="field-error"><c:out value="${errors.title}" /></p></c:if>
    </div>

    <div class="form-row">
        <div class="field${not empty errors.categoryId ? ' has-error' : ''}">
            <label class="label" for="categoryId">Category</label>
            <select class="select" id="categoryId" name="categoryId" required data-msg-required="Please choose a category.">
                <option value="">Choose a category</option>
                <c:forEach var="cat" items="${categories}">
                    <option value="${cat.id}"${form.categoryId == fn:trim(cat.id) ? ' selected' : ''}><c:out value="${cat.name}" /></option>
                </c:forEach>
            </select>
            <c:if test="${not empty errors.categoryId}"><p class="field-error"><c:out value="${errors.categoryId}" /></p></c:if>
        </div>

        <div class="field${not empty errors.price ? ' has-error' : ''}">
            <label class="label" for="price">Price</label>
            <div class="input-group">
                <span class="prefix">&#8377;</span>
                <input class="input" id="price" name="price" inputmode="decimal" value="${fn:escapeXml(form.price)}"
                       required data-money min="10" max="100000" placeholder="450" data-msg-required="Please enter a price.">
            </div>
            <p class="hint">Between &#8377;10 and &#8377;1,00,000.</p>
            <c:if test="${not empty errors.price}"><p class="field-error"><c:out value="${errors.price}" /></p></c:if>
        </div>
    </div>

    <div class="field${not empty errors.condition ? ' has-error' : ''}">
        <span class="label">Condition</span>
        <div class="choice-group" role="radiogroup" aria-label="Condition">
            <c:forEach var="cond" items="${conditions}">
                <label class="choice" title="${fn:escapeXml(cond.hint)}">
                    <input type="radio" name="condition" value="${cond.code}"${form.condition == cond.code ? ' checked' : ''} required
                           data-msg-required="Please choose the item's condition.">
                    <span><c:out value="${cond.label}" /></span>
                </label>
            </c:forEach>
        </div>
        <p class="hint">New: unused &middot; Like new: barely used &middot; Good: normal wear &middot; Fair: visible wear, works fine.</p>
        <c:if test="${not empty errors.condition}"><p class="field-error"><c:out value="${errors.condition}" /></p></c:if>
    </div>

    <div class="field${not empty errors.description ? ' has-error' : ''}">
        <label class="label" for="description">Description</label>
        <textarea class="textarea" id="description" name="description" required minlength="20" maxlength="2000" data-counter
                  placeholder="Edition or model, how long you used it, any marks or missing parts, what's included."
                  data-msg-required="Please describe your item."><c:out value="${form.description}" /></textarea>
        <p class="counter"></p>
        <c:if test="${not empty errors.description}"><p class="field-error"><c:out value="${errors.description}" /></p></c:if>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg" data-busy="${editing ? 'Saving…' : 'Publishing…'}">${editing ? 'Save changes' : 'Publish listing'}</button>
        <a class="btn btn-ghost" href="${ctx}/${editing ? 'my-listings' : 'market'}">Cancel</a>
    </div>
</form>
